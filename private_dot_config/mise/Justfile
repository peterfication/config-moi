# List all available commands
[group('mise')]
mise-default:
  just --list

# Install global mise tools, update the global lockfile, and add it to chezmoi
[group('mise')]
mise-install:
  mise install --cd ~
  just mise-lock-add

# Add the global lockfile to chezmoi
[group('mise')]
mise-lock-add:
  mise lock --global
  chezmoi add ~/.config/mise/mise.lock
