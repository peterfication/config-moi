[delta]
  features = decorations line-numbers
  syntax-theme = Solarized (dark)

[delta "decorations"]
  commit-decoration-style = bold yellow box ul
  file-style = bold yellow
  file-decoration-style = yellow ul
  hunk-header-line-number-style = brightblue
  hunk-header-decoration-style = brightblue box ul

[delta "line-numbers"]
  line-numbers-left-format = "{nm:>3}│"
  line-numbers-left-style = gray
  line-numbers-right-format = " {np:>3}│"
  line-numbers-right-style = gray
  line-numbers-minus-style = black brightred bold
  line-numbers-plus-style = black brightgreen bold
  line-numbers-zero-style = gray
