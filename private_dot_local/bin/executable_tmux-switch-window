#!/usr/bin/env sh

list_windows() {
	tmux list-windows -a -F '#{session_last_attached}|#{t/p:session_last_attached}|#{session_name}|#{window_index}:#{window_name}|#{session_id}|#{window_id}' |
		sort -t '|' -k1,1nr -k4,4n |
		awk -F '|' '{print $2 "\t" $3 "\t" $4 "\t" $5 "\t" $6}'
}

shell_quote() {
	printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

case "${1:-}" in
--list)
	list_windows
	exit 0
	;;
-h | --help)
	printf 'Usage: tmux-switch-window\n'
	exit 0
	;;
esac

# FZF_PREVIEW_LINES is expanded by fzf's preview shell, not this script.
# shellcheck disable=SC2016
preview_command='tmux capture-pane -ep -t {5} | tail -n "${FZF_PREVIEW_LINES:-40}"'
case "$0" in
*/*)
	script_path=$0
	;;
*)
	script_path=$(command -v "$0" || command -v tmux-switch-window || printf '%s' "$0")
	;;
esac

if [ -x "$script_path" ]; then
	reload_command="$(shell_quote "$script_path") --list"
else
	reload_command="sh $(shell_quote "$script_path") --list"
fi
reload_action="reload-sync($reload_command)"
# FZF_PORT and TMUX_SWITCH_WINDOW_REFRESH_INTERVAL are expanded by fzf's
# child shell.
# shellcheck disable=SC2016
refresh_command="while sleep \"\${TMUX_SWITCH_WINDOW_REFRESH_INTERVAL:-1}\"; do curl -fsS -XPOST \"localhost:\$FZF_PORT\" -d $(shell_quote "$reload_action") >/dev/null 2>&1 || exit; done &"

selected=$(
	list_windows |
		fzf-tmux -p 100%,100% -- \
			--header '[Switch window]' \
			--delimiter='\t' \
			--with-nth=1,2,3 \
			--id-nth=2,3 \
			--listen \
			--bind "start:execute-silent:$refresh_command" \
			--bind "ctrl-r:$reload_action" \
			--preview-window=right:80% \
			--preview="$preview_command"
) || exit 0

session_id=$(printf '%s' "$selected" | awk -F '\t' '{print $4}')
window_id=$(printf '%s' "$selected" | awk -F '\t' '{print $5}')

if [ -n "$session_id" ] && [ -n "$window_id" ]; then
	tmux switch-client -t "$session_id" \; select-window -t "$window_id"
fi
