#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# ///
"""
Log the OpenShell gateway in to the hosted Notion MCP (https://mcp.notion.com/mcp).

Registers a separate OAuth client for the gateway (so the Notion login of Claude Code on
the host is not affected), runs the OAuth authorization code flow with PKCE in the
browser, and stores the tokens in OpenShell:

- the access token as the `notion` provider credential NOTION_MCP_TOKEN (sandboxes only
  see a placeholder)
- the client id and refresh token as gateway-only refresh material, so the gateway
  refreshes the access token by itself

Run it again to log in from scratch, e.g. after the refresh token was revoked.

Usage:
  openshell-notion-login [--provider NAME] [--profile-only]

Attach the provider to a sandbox:
  openshell-claude --provider notion
  openshell sandbox provider attach SANDBOX notion
"""

import argparse
import base64
import hashlib
import http.server
import json
import os
import secrets
import socket
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
import webbrowser
from pathlib import Path

MCP_RESOURCE = "https://mcp.notion.com/mcp"
REGISTRATION_ENDPOINT = "https://mcp.notion.com/register"
AUTHORIZATION_ENDPOINT = "https://mcp.notion.com/authorize"
TOKEN_ENDPOINT = "https://mcp.notion.com/token"
SCOPE = "default"
PROFILE_FILE = Path.home() / ".config/openshell/notion/notion-mcp.yaml"
PROFILE_ID = "notion-mcp"
CREDENTIAL_KEY = "NOTION_MCP_TOKEN"
LOGIN_TIMEOUT_SECONDS = 300


def die(message: str) -> None:
    print(f"openshell-notion-login: {message}", file=sys.stderr)
    sys.exit(1)


def post(url: str, data: bytes, content_type: str) -> dict:
    request = urllib.request.Request(
        url,
        data=data,
        headers={"Content-Type": content_type, "Accept": "application/json"},
        method="POST",
    )
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            return json.load(response)
    except urllib.error.HTTPError as error:
        die(f"{url} returned {error.code}: {error.read().decode(errors='replace')}")


def register_client(redirect_uri: str) -> dict:
    payload = {
        "client_name": f"OpenShell gateway ({socket.gethostname()})",
        "redirect_uris": [redirect_uri],
        "grant_types": ["authorization_code", "refresh_token"],
        "response_types": ["code"],
        "token_endpoint_auth_method": "none",
    }
    return post(REGISTRATION_ENDPOINT, json.dumps(payload).encode(), "application/json")


def wait_for_code(server: http.server.HTTPServer, state: str) -> str:
    result: dict[str, str] = {}

    class CallbackHandler(http.server.BaseHTTPRequestHandler):
        def do_GET(self) -> None:
            query = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
            if query.get("state", [""])[0] != state:
                result["error"] = "state mismatch"
            elif "error" in query:
                result["error"] = query["error"][0]
            else:
                result["code"] = query.get("code", [""])[0]
            message = (
                "Notion login failed, see the terminal."
                if "error" in result
                else "Notion login done. You can close this tab."
            )
            self.send_response(200)
            self.send_header("Content-Type", "text/plain; charset=utf-8")
            self.end_headers()
            self.wfile.write(message.encode())

        def log_message(self, format: str, *args: object) -> None:
            pass

    server.RequestHandlerClass = CallbackHandler
    server.timeout = LOGIN_TIMEOUT_SECONDS
    server.handle_request()
    if "error" in result:
        die(f"authorization failed: {result['error']}")
    if not result.get("code"):
        die("no authorization code received (timed out?)")
    return result["code"]


def openshell(*args: str, env: dict[str, str] | None = None) -> None:
    subprocess.run(["openshell", *args], check=True, env={**os.environ, **(env or {})})


def provider_exists(name: str) -> bool:
    return (
        subprocess.run(
            ["openshell", "provider", "get", name],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        ).returncode
        == 0
    )


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Log the OpenShell gateway in to the hosted Notion MCP."
    )
    parser.add_argument(
        "--provider", default="notion", help="Provider name (default: notion)"
    )
    parser.add_argument(
        "--profile-only", action="store_true", help="Only sync the provider profile"
    )
    args = parser.parse_args()

    subprocess.run(["openshell-profile-sync", str(PROFILE_FILE)], check=True)
    if args.profile_only:
        return

    server = http.server.HTTPServer(
        ("127.0.0.1", 0), http.server.BaseHTTPRequestHandler
    )
    redirect_uri = f"http://127.0.0.1:{server.server_port}/callback"

    client = register_client(redirect_uri)
    client_id = client["client_id"]

    code_verifier = secrets.token_urlsafe(64)
    code_challenge = (
        base64.urlsafe_b64encode(hashlib.sha256(code_verifier.encode()).digest())
        .rstrip(b"=")
        .decode()
    )
    state = secrets.token_urlsafe(32)
    authorization_url = (
        AUTHORIZATION_ENDPOINT
        + "?"
        + urllib.parse.urlencode(
            {
                "response_type": "code",
                "client_id": client_id,
                "redirect_uri": redirect_uri,
                "code_challenge": code_challenge,
                "code_challenge_method": "S256",
                "state": state,
                "scope": SCOPE,
                "resource": MCP_RESOURCE,
            }
        )
    )

    print(
        f"Opening the Notion login in your browser. If it does not open, visit:\n\n  {authorization_url}\n"
    )
    webbrowser.open(authorization_url)
    code = wait_for_code(server, state)

    token_params = {
        "grant_type": "authorization_code",
        "code": code,
        "redirect_uri": redirect_uri,
        "client_id": client_id,
        "code_verifier": code_verifier,
        "resource": MCP_RESOURCE,
    }
    if client.get("client_secret"):
        token_params["client_secret"] = client["client_secret"]
    tokens = post(
        TOKEN_ENDPOINT,
        urllib.parse.urlencode(token_params).encode(),
        "application/x-www-form-urlencoded",
    )
    if not tokens.get("refresh_token"):
        die(
            "Notion did not return a refresh token, the gateway cannot refresh the access token"
        )

    expires_at = str(int((time.time() + int(tokens.get("expires_in", 3600))) * 1000))
    # Secrets go through the environment, never through process arguments
    secret_env = {
        CREDENTIAL_KEY: tokens["access_token"],
        "NOTION_MCP_REFRESH_TOKEN": tokens["refresh_token"],
        "NOTION_MCP_CLIENT_SECRET": client.get("client_secret", ""),
    }

    if provider_exists(args.provider):
        openshell(
            "provider",
            "update",
            args.provider,
            "--credential",
            CREDENTIAL_KEY,
            env=secret_env,
        )
    else:
        openshell(
            "provider",
            "create",
            "--name",
            args.provider,
            "--type",
            PROFILE_ID,
            "--credential",
            CREDENTIAL_KEY,
            env=secret_env,
        )

    refresh_args = [
        "provider",
        "refresh",
        "configure",
        args.provider,
        "--credential-key",
        CREDENTIAL_KEY,
        "--strategy",
        "oauth2-refresh-token",
        "--material",
        f"client_id={client_id}",
        "--secret-material-env",
        "refresh_token=NOTION_MCP_REFRESH_TOKEN",
        "--credential-expires-at",
        expires_at,
    ]
    if client.get("client_secret"):
        refresh_args += [
            "--secret-material-env",
            "client_secret=NOTION_MCP_CLIENT_SECRET",
        ]
    openshell(*refresh_args, env=secret_env)

    print(
        f"\nNotion MCP provider '{args.provider}' is ready. Attach it with:"
    )
    print(
        f"\n  openshell-claude --provider {args.provider}"
    )


if __name__ == "__main__":
    main()
